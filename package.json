{
  "name": "whiteboard-recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:http": "VITE_RECORDING_STORAGE=http vite",
    "dev:api": "node scripts/mock-backend.mjs",
    "dev:sync": "node scripts/sync-server.mjs",
    "dev:java": "cd server && mvn -q -s maven-central-settings.xml spring-boot:run",
    "desktop:dev": "node scripts/electron-dev.mjs",
    "desktop:build": "npm run build && electron-builder",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.whiteboard.recorder",
    "productName": "Whiteboard Recorder",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!server/**/*",
      "!scripts/**/*",
      "!node_modules/better-sqlite3/**/*",
      "!node_modules/@tldraw/sync-core/**/*",
      "!node_modules/ws/**/*"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "@tldraw/sync": "^4.5.12",
    "@tldraw/sync-core": "^4.5.12",
    "@vitejs/plugin-react": "^5.0.0",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldraw": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}

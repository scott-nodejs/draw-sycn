# Copy this file to .env.local and replace every CHANGE_ME value.

# Server
SERVER_PORT=8788

# MySQL
MYSQL_URL=jdbc:mysql://YOUR_RDS_HOST:3306/whiteboard?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# DeepSeek semantic structuring
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OCR provider: paddleocr or mineru
OCR_PROVIDER=paddleocr

# PaddleOCR-VL
PADDLEOCR_API_TOKEN=CHANGE_ME
PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_MODEL=PaddleOCR-VL-1.6

# PP-Structure document layout
PADDLE_LAYOUT_ENABLED=true
PADDLE_LAYOUT_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLE_LAYOUT_MODEL=PP-StructureV3

# MinerU (configured even when PaddleOCR is the primary provider)
MINERU_API_KEY=CHANGE_ME
MINERU_API_BASE_URL=https://mineru.net/api/v4

# Tencent TRTC
TRTC_SDK_APP_ID=CHANGE_ME
TRTC_SECRET_KEY=CHANGE_ME
TRTC_USER_SIG_TTL_SECONDS=7200

# Qiniu recording/object storage
QINIU_ACCESS_KEY=CHANGE_ME
QINIU_SECRET_KEY=CHANGE_ME
QINIU_BUCKET=CHANGE_ME
QINIU_UPLOAD_URL=https://up-z1.qiniup.com
QINIU_PUBLIC_DOMAIN=CHANGE_ME
QINIU_TOKEN_EXPIRE_SECONDS=3600


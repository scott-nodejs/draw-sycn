VITE_RECORDING_STORAGE=qiniu
VITE_RECORDING_API_BASE_URL=http://127.0.0.1:8788/api
VITE_TLDRAW_SYNC_URL=ws://127.0.0.1:8790/sync
VITE_STUDENT_APP_URL=http://127.0.0.1:5174
VITE_TEACHER_AGENT_WEB_URL=http://127.0.0.1:5176
# Commercial teaching business API. When omitted, the frontend uses an isolated
# in-memory development repository; production must provide this endpoint.
# VITE_TEACHING_API_BASE_URL=http://127.0.0.1:8788/api
# Development identity only. Production should inject identity from the auth layer.
# VITE_API_USER_ID=teacher_001
# VITE_API_ORGANIZATION_ID=org_001

# Java paper-processing workers (server-side only; never expose these as VITE_*).
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MINERU_API_KEY=
MINERU_API_BASE_URL=https://mineru.net/api/v4
# PaddleOCR/PP is the product OCR provider. MinerU remains an optional fallback.
OCR_PROVIDER=paddleocr
PADDLEOCR_API_TOKEN=
PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
PAPER_PROCESSING_INTERVAL_MS=5000
# The same token/jobs API is called separately: Structure supplies layout only,
# while PaddleOCR-VL remains the authoritative OCR/Markdown provider.
PADDLE_LAYOUT_ENABLED=true
PADDLE_LAYOUT_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLE_LAYOUT_MODEL=PP-StructureV3

# Qiniu North China upload endpoint for bucket yima-h5.
QINIU_UPLOAD_URL=https://up-z1.qiniup.com
